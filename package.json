{
  "name": "dentplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "try-agent": "tsx --env-file-if-exists=.env scripts/try-agent.ts",
    "sample-pdf": "tsx scripts/sample-pdf.tsx",
    "docs:pdf": "node scripts/architecture-pdf.mjs",
    "import-prices": "tsx scripts/import-prices.ts",
    "test-patients": "tsx --env-file-if-exists=.env scripts/test-patients.tsx"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "read-excel-file": "^9.3.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
