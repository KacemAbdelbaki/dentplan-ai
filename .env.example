# Get a Gemini API key at https://aistudio.google.com/apikey, paste it below, then save this file as .env
GEMINI_API_KEY=
# Optional: which Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Optional: port for the server
PORT=3001
# Optional: backup models, used when the main one is overloaded, slow or out of quota
# GEMINI_FALLBACK_MODELS=gemini-4-hydrogen,gemini-3.5-flash-lite
# Optional: start the next model if one has not answered after this many ms (default 20000)
# GEMINI_HEDGE_DELAY_MS=20000
# Optional: time limit in ms for one assistant turn, all models together (default 120000)
# GEMINI_TURN_BUDGET_MS=120000
# Optional: a last-resort backup on another provider (Groq), used only when every Gemini model fails.
# Get a key at https://console.groq.com/keys. The free tier only accepts small requests (about 8,000 tokens a minute).
# GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b
# Required whenever the app is reachable from outside this computer (e.g. through ngrok):
# a password for the web app. The browser asks for it; any user name works.
# DENTPLAN_PASSWORD=
